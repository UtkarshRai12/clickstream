target/
.idea/
*.iml

# JSON logs written at runtime. Alloy reads this directory. Do not commit it.
logs/

# SQLite file written by the ingress agent. Reports stay on this machine.
data/

# Local secrets. api-keys.csv comments hold the plaintext keys.
# application.properties holds jwt.hmac-secret and internal.token.
config/api-keys.csv
config/application.properties
# Agent keys (Gemini, Langfuse pk/sk). agent.properties itself has no secrets.
config/agent.env
# Langfuse container secrets. Only .env.example is committed.
ops/langfuse/.env

# Written by Cursor's Java language server (Eclipse JDT). Not an Eclipse install.
.project
.classpath
.factorypath
.settings/

# Scratch Postman body. Not part of the project.
batch-100.json
