{
  "uid": "clickstream",
  "title": "Clickstream",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Events accepted",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(clickstream_events_accepted_total[1m]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Events rejected",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (code) (rate(clickstream_events_rejected_total[1m]))",
          "legendFormat": "{{code}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Ingest queue depth",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "clickstream_ingest_queue_depth"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Stream load failures",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "clickstream_stream_load_failures_total"
        }
      ]
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Logs. Add | request_id=\"...\" to follow one call.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"edge|server|agent\"} | json request_id=\"mdc.request_id\", tenant_id=\"mdc.tenant_id\", route=\"mdc.route\", logger=\"loggerName\""
        }
      ]
    }
  ]
}
