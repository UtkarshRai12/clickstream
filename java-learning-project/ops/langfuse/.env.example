# Copy to ops/langfuse/.env (gitignored), or run ops/langfuse/make-env.sh,
# which fills every value with random secrets.
#
# NEXTAUTH_SECRET, SALT: openssl rand -base64 32
# ENCRYPTION_KEY: exactly 64 hex chars, openssl rand -hex 32
NEXTAUTH_SECRET=
SALT=
ENCRYPTION_KEY=

# Passwords for the containers on the compose network. Any random string.
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_AUTH=
MINIO_ROOT_PASSWORD=

# The first Langfuse login. Created on first boot.
LANGFUSE_INIT_USER_EMAIL=admin@clickstream.local
LANGFUSE_INIT_USER_PASSWORD=

# The project API key pair. Must start with pk-lf- and sk-lf-.
# The agent sends them as HTTP Basic auth (pk = user, sk = password).
# Put the same two values in config/agent.env.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
