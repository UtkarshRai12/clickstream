<?xml version="1.0" encoding="UTF-8"?>
<!--
  Quiet console while the page is up. Jetty's own debug stream hides the request.
  The JSON file for the agent process is added when the process gets a main class.
-->
<configuration>
  <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level [%logger{20}] %msg%n</pattern>
    </encoder>
  </appender>

  <logger name="org.eclipse.jetty" level="WARN"/>

  <root level="INFO">
    <appender-ref ref="console"/>
  </root>
</configuration>
